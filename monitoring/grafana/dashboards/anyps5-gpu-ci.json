      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "Value": true
      },
      "renameByName": {
       "pr": "PR"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
