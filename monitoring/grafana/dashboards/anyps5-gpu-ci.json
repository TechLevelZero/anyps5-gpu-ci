  {
   "type": "row",
   "title": "Results",
   "id": 16,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "panels": []
  },
  {
   "type": "table",
   "title": "Latest result per PR",
   "targets": [
    {
     "refId": "K",
     "expr": "anyps5ci_pr_result_timestamp_seconds",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true
      },
      "indexByName": {
       "pr": 0,
       "outcome": 1,
       "title": 2,
       "author": 3,
       "head": 4,
       "main": 5,
       "Value": 6
      },
      "renameByName": {
       "Value": "tested",
       "pr": "PR"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "tested",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "tested"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dateTimeAsIso"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "tested"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 190
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "PR"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open PR",
          "url": "https://github.com/boykopovar/AnyPS5/pull/${__value.raw}",
          "targetBlank": true
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "outcome"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "passed": {
            "color": "green"
           },
           "tests-failed": {
            "color": "red"
           },
           "validation-failed": {
            "color": "red"
           },
           "build-failed": {
            "color": "dark-red"
           },
           "merge-conflict": {
            "color": "orange"
           },
           "infra-error": {
            "color": "purple"
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "id": 17,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
