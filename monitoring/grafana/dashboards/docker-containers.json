      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "D",
     "expr": "max by (name) (container_spec_memory_limit_bytes{name=~\"$container\", name!=\"\"} > 0)",
