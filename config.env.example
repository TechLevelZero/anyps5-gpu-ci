# AnyPS5 GPU CI: the one config file. Copy to config.env and fill in.
# Docker Compose reads this through the .env symlink; the poller gets it as its environment.

# --- GitHub -------------------------------------------------------------------
# Classic token with only the public_repo and gist scopes. A fine-grained token
# cannot comment on a repository owned by someone else. Without a token the
# poller can still run in dry-run mode, but GitHub limits it to 60 API calls an hour.
GITHUB_TOKEN=
GITHUB_REPO=boykopovar/AnyPS5

# false = dry run: reports are written to data/runs/ and shown in Grafana only.
# true  = post one comment per pushed head on GitHub.
POST_COMMENTS=false

# With POST_COMMENTS=true, upload each run's build and test logs to a secret gist
# and link it from the comment.
GIST_LOGS=true

# Hidden marker that identifies our comments.
COMMENT_MARKER=<!-- anyps5-nvidia-ci -->

# --- Which PRs to test --------------------------------------------------------
# gpu-paths: only PRs that change a path starting with one of GPU_PATHS
# all:       every open PR against main (about 1,400; expect a long queue)
PR_FILTER=gpu-paths
GPU_PATHS=core/libs/prx/libSceAgc,core/shader/,core/libs/prx/libSceVideoOut,core/libs/prx/libSceGnmDriver
# Comma-separated PR numbers that are always / never tested, regardless of PR_FILTER.
INCLUDE_PRS=
EXCLUDE_PRS=
SKIP_DRAFTS=true
# Skip PRs whose changes under GPU_PATHS are only export stubs (functions that just call
# NotImplemented_nid_no_patch and return), APS5_EXPORT lines, declarations, includes and Markdown:
# nothing new to run.
SKIP_STUB_ONLY=true
# Only consider PRs updated in the last N days (0 = no limit).
MAX_PR_AGE_DAYS=30

# --- Scheduling ---------------------------------------------------------------
# How often to fetch upstream and refresh the PR list. Free slots are filled every 30 s.
POLL_INTERVAL_SECONDS=900
# A PR is tested once per head commit: a new push or rebase triggers a run, a moving main does not.
# PRs are merged onto the newest main that already has a finished baseline. A new main
# baseline starts at most this often. It is incremental: only the tests main's changes since
# the previous baseline can reach run (tools/select_tests.py); the rest are carried over.
BASELINE_INTERVAL_MINUTES=360
# A full baseline (every test, ~1-2 h of one GPU slot) at least this often; only full
# baselines feed the "unstable on main" history.
BASELINE_FULL_HOURS=12

# --- Pools --------------------------------------------------------------------
# Builds run on CPU only, many at once. Built PRs then queue for the GPU pool.
MAX_BUILDS=4
BUILD_CPUS=32
BUILD_MEMORY=24g
# Tests that don't match VALIDATION_TESTS run in the build container without a GPU; any that
# fail or skip there are run again on the GPU.
CPU_TEST_PARALLEL=32
# GPU test runs at once. The limit is the NVIDIA driver's global API lock, not GPU utilisation:
# every test process creating and destroying a Vulkan device takes it. On an idle RTX 2000 Ada,
# GPU tests peak at ~3.2/s with ~8 running in total and get slower past that (2.5/s at 32).
# Keep MAX_GPU_RUNS x TEST_PARALLEL around 8-12. Failing tests are re-run alone before they count.
MAX_GPU_RUNS=3
TEST_MEMORY=16g
# ctest jobs inside each GPU run.
TEST_PARALLEL=4
# GPU tests: run once on the GPU with VK_LAYER_KHRONOS_validation and ANYPS5_NO_SHADER_CACHE=1, on
# main and the PR; their VUID-/SYNC-HAZARD IDs are compared. All other tests run without a GPU.
VALIDATION_TESTS=^(agc|shader|recompiler|videoout|video_out|guest_video_out|vulkan)|gpu
RUN_TIMEOUT_MINUTES=120
CCACHE_MAXSIZE=60G
# Substring of the Vulkan device name; exported as ANYPS5_GPU.
GPU_NAME=NVIDIA

# --- Grafana ------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000

# --- Host (filled by install.sh; normally leave alone) -------------------------
DATA_DIR=
HOST_UID=1000
HOST_GID=1000
DOCKER_GID=
